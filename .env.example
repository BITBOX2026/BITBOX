# ==========================================
# BITBOX Backend Environment Variables
# 실제 API 키는 .env 파일에만 입력하고 GitHub에는 절대 올리지 말 것
# ==========================================

# =========================
# 실행 모드
# true  : 외부 API를 호출하지 않고 mock 데이터로 테스트
# false : 실제 OpenAI / Kakao / ODsay / 공공데이터 API 호출
# =========================
USE_MOCK_EXTERNALS=true

# =========================
# OpenAI API
# 용도:
# - STT: 음성 파일을 텍스트로 변환
# - LLM: 사용자 문장을 JSON으로 구조화
# =========================
OPENAI_API_KEY=

# =========================
# Kakao Local API
# 용도:
# - 출발지/목적지 장소명 -> 좌표 변환
# =========================
KAKAO_REST_API_KEY=

# =========================
# ODsay API
# 용도:
# - 출발지 좌표 + 목적지 좌표 기반 대중교통 경로 조회
# =========================
ODSAY_API_KEY=

# =========================
# Public Data API
# 용도:
# - 실시간 버스 도착 정보 조회
# =========================
PUBLIC_DATA_SERVICE_KEY=

# =========================
# 선택 설정: 기본 출발지 좌표
# 현재는 사용자가 출발지도 말하게 할 예정이므로 필수 아님
# 나중에 고정 설치형 fallback으로 사용할 수 있음
# =========================
DEFAULT_ORIGIN_X=
DEFAULT_ORIGIN_Y=

# =========================
# 서버 설정
# =========================
MAX_AUDIO_SIZE_MB=10
REQUEST_TIMEOUT_SECONDS=30

# =========================
# Raspberry Pi / Client 설정
# 로컬 테스트 시:
# API_URL=http://127.0.0.1:8000/api/process
#
# AWS 배포 후:
# API_URL=http://EC2_PUBLIC_IP:8000/api/process
# =========================
API_URL=http://127.0.0.1:8000/api/process

# =========================
# 오디오 설정
# =========================
AUDIO_OUTPUT_PATH=recorded_audio.wav
RECORD_SECONDS=5
SAMPLE_RATE=16000
