# ==========================================
# BITBOX Backend 환경변수 설정 예시
#
# 사용법:
# 1. 이 파일을 .env로 복사합니다: cp .env.example .env
# 2. 실제 API 키를 입력합니다.
# 3. .env 파일은 절대 GitHub에 업로드하지 마세요.
# ==========================================


# ==========================================
# 실행 모드
#
# true  : 외부 API를 호출하지 않고 mock 데이터로 동작 (개발/테스트용)
# false : 실제 OpenAI / Kakao / ODsay / 공공데이터 API 호출
# ==========================================
USE_MOCK_EXTERNALS=true

# 실행 환경 구분 (local / dev / prod)
APP_ENV=local


# ==========================================
# OpenAI API
#
# 용도:
# - STT : 음성 파일을 텍스트로 변환 (Whisper)
# - LLM : 사용자 문장을 교통 요청 JSON으로 구조화 (GPT)
# - TTS : 안내 문장을 음성으로 변환
#
# 발급: https://platform.openai.com/api-keys
# ==========================================
OPENAI_API_KEY=

# AI 모델 설정 (기본값 그대로 사용 권장)
STT_MODEL=gpt-4o-mini-transcribe
LLM_MODEL=gpt-4o-mini
INTENT_FAST_PATH_ENABLED=true
TTS_MODEL=tts-1-hd
TTS_VOICE=nova

# 커스텀 LLM 시스템 프롬프트 파일 경로 (비워두면 내장 프롬프트 사용)
# 예: LLM_SYSTEM_PROMPT_FILE=prompts/custom_prompt.txt
LLM_SYSTEM_PROMPT_FILE=


# ==========================================
# Kakao Local API
#
# 용도: 출발지/목적지 장소명 → 경도/위도 좌표 변환
#
# 발급: https://developers.kakao.com → 애플리케이션 → REST API 키
# ==========================================
KAKAO_REST_API_KEY=


# ==========================================
# ODsay API
#
# 용도: 출발지 좌표 + 목적지 좌표 기반 버스 전용 경로 조회
#
# 발급: https://lab.odsay.com
# ==========================================
ODSAY_API_KEY=


# ==========================================
# 공공데이터 API (서울시 버스 도착 정보)
#
# 용도: 특정 정류장의 실시간 버스 도착 시간 조회
#
# 발급: https://www.data.go.kr → "서울특별시_버스도착정보조회" 서비스 신청
# 인코딩 키 또는 디코딩 키 모두 사용 가능합니다.
# ==========================================
PUBLIC_DATA_SERVICE_KEY=
SEOUL_BUS_API_KEY=


# ==========================================
# 기기 설치 위치 (버스 정류장 고정 설치 시 설정)
#
# DEFAULT_ORIGIN_NAME 설정 시:
#   - Kakao API로 장소명 → 좌표 자동 변환
#   - 사용자가 출발지를 말하지 않아도 됨
#   예) DEFAULT_ORIGIN_NAME=수원역
#
# 좌표를 직접 입력할 수도 있습니다:
#   - DEFAULT_ORIGIN_X=경도 (예: 127.0276)
#   - DEFAULT_ORIGIN_Y=위도 (예: 37.4979)
#
# 모두 비워두면 사용자가 매번 출발지를 말해야 합니다.
# ==========================================
DEFAULT_ORIGIN_NAME=올림픽공원역
DEFAULT_ORIGIN_X=
DEFAULT_ORIGIN_Y=


# ==========================================
# 프론트 화면 기본 버스 도착정보
#
# DEFAULT_BUS_STATION_ID가 있으면 해당 서울 버스 정류소 번호로 바로 조회합니다.
# 비워두면 DEFAULT_BUS_STOP_NAME으로 서울 정류장을 검색해 첫 번째 적합한 정류장을 사용합니다.
# ==========================================
DEFAULT_BUS_STOP_NAME=올림픽공원역
DEFAULT_BUS_STATION_ID=24245


# ==========================================
# 서버 동작 설정
# ==========================================

# 업로드 허용 최대 오디오 파일 크기 (MB)
MAX_AUDIO_SIZE_MB=10

# 파이프라인 전체 처리 타임아웃 (초)
REQUEST_TIMEOUT_SECONDS=30

# TTS 음성 생성만 따로 기다리는 최대 시간 (초)
# 이 시간이 지나도 텍스트 응답은 정상 반환됩니다.
TTS_TIMEOUT_SECONDS=8

# 외부 API를 사용하는 /api 경로 보호용 토큰
# 비워두면 인증 없이 동작합니다. 배포 환경에서는 긴 임의 문자열을 설정하고
# 라즈베리파이 클라이언트에도 같은 값을 설정하세요.
API_AUTH_TOKEN=

# CORS 허용 출처
# * : 모든 출처 허용 (개발용)
# 특정 도메인만 허용: https://example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# IP 기반 rate limit 활성화 여부
RATE_LIMIT_ENABLED=true

# 유료/제한형 외부 API 비용 보호 (단일 프로세스 기준)
VOICE_MAX_CONCURRENT_REQUESTS=4
VOICE_DAILY_REQUEST_LIMIT=500
ROUTE_MAX_CONCURRENT_REQUESTS=12
ROUTE_DAILY_REQUEST_LIMIT=5000
PLACE_MAX_CONCURRENT_REQUESTS=12
PLACE_DAILY_REQUEST_LIMIT=10000

# 외부 교통 API 연속 실패 시 일시 차단
EXTERNAL_CIRCUIT_FAILURE_THRESHOLD=5
EXTERNAL_CIRCUIT_RESET_SECONDS=30

# Kakao API 실패 시 알려진 테스트 장소 좌표로 보조 조회할지 여부
# 운영(APP_ENV=prod)에서는 false 권장
ALLOW_KNOWN_PLACE_FALLBACK=true


# ==========================================
# 라즈베리파이 클라이언트 설정은 클라이언트 .env에서 관리합니다.
# API_URL, AUDIO_OUTPUT_PATH, RECORD_SECONDS, SAMPLE_RATE 등은
# 서버 설정이 아니므로 이 파일에 포함하지 않습니다.
# ==========================================
