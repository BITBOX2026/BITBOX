# Environment variables
.env
.env.*
*.env
!.env.example

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pycache_tmp/

# Virtual environments
venv/
.venv/

# Build outputs
build/
dist/
*.egg-info/

# Test/tool cache
.pytest_cache/
# 알림 테스트가 남기는 basetemp. Windows에서 ACL이 잠겨 삭제되지 않는 경우가
# 있어, 남더라도 작업 트리를 더럽히지 않도록 무시합니다.
.pytest-alert*/
.mypy_cache/
.ruff_cache/

# Logs
*.log
logs/

# Editor and OS files
.vscode/
.claude/
.DS_Store
Thumbs.db

# Local audio test files
recorded_audio.wav
test_audio.mp3
test_audio.wav
voice-samples/
evaluation-results/

# Temporary files
tmp/
temp/

# Submission demo: keep only final deliverables in Git
artifacts/*
!artifacts/BITBOX-Hanium-submission-demo.mp4
!artifacts/BITBOX-Hanium-submission-demo.srt

# 실기기 촬영 원본입니다. 수백 MB 라 저장소에 넣지 않고 별도로 보관합니다.
# 편집을 다시 해야 할 때 필요하므로 지우지 마십시오.
screen/

# 다른 도구가 받아 둔 ffmpeg 파이썬 패키지입니다. 시스템 ffmpeg 로 충분합니다.
.codex-ffmpeg/
