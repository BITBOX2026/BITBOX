server {
    listen 80;
    server_name ${BITBOX_SERVER_NAME};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen 8000 ssl;
    server_name ${BITBOX_SERVER_NAME};

    ssl_certificate ${BITBOX_TLS_CERT_PATH};
    ssl_certificate_key ${BITBOX_TLS_KEY_PATH};
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 11m;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Permissions-Policy "microphone=(self)" always;

    root /home/ubuntu/BITBOX/frontend/dist;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_read_timeout 40s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-BITBOX-Token ${BITBOX_API_AUTH_TOKEN};
    }

    location /health {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
