APP_ENV=prod
USE_MOCK_EXTERNALS=false
CORS_ALLOWED_ORIGINS=
API_AUTH_TOKEN=replace-with-a-long-random-value
RELEASE_SHA=replace-with-the-40-character-git-commit-sha
USAGE_DB_PATH=/var/lib/bitbox/usage.sqlite3

DEFAULT_ORIGIN_NAME=올림픽공원역
DEFAULT_BUS_STOP_NAME=올림픽공원역
DEFAULT_BUS_STATION_ID=24245

OPENAI_API_KEY=
KAKAO_REST_API_KEY=
ODSAY_API_KEY=
PUBLIC_DATA_SERVICE_KEY=

# 심사·시연용으로 공개된 주소이므로 한도는 유료 API 비용의 상한선이기도 합니다.
# 시연 한 번이 음성 10~20회 수준이라 그보다 열 배 남는 선으로 잡되, 무제한으로
# 두지는 않습니다. 코드 기본값과 같은 값입니다(app/core/config.py).
VOICE_MAX_CONCURRENT_REQUESTS=4
VOICE_DAILY_REQUEST_LIMIT=200
ROUTE_MAX_CONCURRENT_REQUESTS=12
ODSAY_MAX_CONCURRENT_REQUESTS=3
ODSAY_DAILY_CALL_LIMIT=30
PLACE_MAX_CONCURRENT_REQUESTS=12
PLACE_DAILY_REQUEST_LIMIT=3000
SPEECH_DAILY_REQUEST_LIMIT=800
EXTERNAL_HTTP_TIMEOUT_SECONDS=8
PLACE_REQUEST_TIMEOUT_SECONDS=7
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=0
STT_TIMEOUT_SECONDS=12
LLM_TIMEOUT_SECONDS=10
LLM_ATTEMPT_TIMEOUT_SECONDS=4
LLM_RETRY_WAIT_SECONDS=0.5
EXTERNAL_CIRCUIT_FAILURE_THRESHOLD=5
EXTERNAL_CIRCUIT_RESET_SECONDS=30
